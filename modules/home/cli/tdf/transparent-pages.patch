+/// Recolour a page the way zathura's `recolor-reverse-video` does, rather than
+/// by tinting every pixel between two endpoints.
+///
+/// Pixels that carry real chroma - photos, coloured figures, syntax
+/// highlighting - are left exactly as the document authored them. Pixels that
+/// are grey (which is to say the paper, the text, and the rules) are redrawn
+/// as `ink` with an alpha taken from how dark they were: black ink becomes
+/// fully opaque ink, white paper becomes fully transparent, and the
+/// antialiasing in between survives as partial alpha.
+///
+/// The transparent paper is the point: it means the terminal's own background
+/// - and so its opacity, its blur, and the wallpaper behind it - is what shows
+/// through the page, instead of a rectangle painted to look similar.
+///
+/// mupdf stores samples premultiplied; the values written here are straight,
+/// which is what the Kitty graphics protocol expects. Fully opaque pixels are
+/// identical under either reading, so the pixels left untouched don't care.
+fn reverse_video(pixmap: &mut Pixmap, ink: i32) {
+	// How far apart the channels may be for a pixel to still count as grey.
+	// Generous enough to catch the off-whites and warm greys that documents
+	// use for paper, tight enough to leave a washed-out photo alone.
+	const CHROMA_TOLERANCE: u8 = 24;
+
+	let [_, ink_r, ink_g, ink_b] = ink.to_be_bytes();
+	let n = pixmap.n() as usize;
+	if n != 4 {
+		return;
+	}
+
+	for px in pixmap.samples_mut().chunks_exact_mut(n) {
+		let alpha = px[3];
+		if alpha == 0 {
+			// never painted; the page is already showing the terminal here
+			continue;
+		}
+
+		// undo the premultiplication before judging the colour
+		let un = |c: u8| ((u32::from(c) * 255) / u32::from(alpha)).min(255) as u8;
+		let (r, g, b) = (un(px[0]), un(px[1]), un(px[2]));
+
+		let max = r.max(g).max(b);
+		let min = r.min(g).min(b);
+		if max - min > CHROMA_TOLERANCE {
+			continue;
+		}
+
+		let lightness = ((u32::from(r) + u32::from(g) + u32::from(b)) / 3) as u8;
+
+		// Straight `255 - lightness` is the honest mapping, but it reads thin:
+		// at the size a page lands in a terminal most of a glyph is
+		// antialiasing rather than core, and text that is a dark grey rather
+		// than true black never reaches full ink at all. Stretching the range
+		// pushes the core opaque and leaves off-white paper at zero, which
+		// matters — a few percent of alpha across the whole sheet would put
+		// the page rectangle back as a veil.
+		const PAPER_FLOOR: u32 = 16;
+		const INK_CEIL: u32 = 216;
+
+		let coverage = u32::from(u8::MAX - lightness);
+		px[0] = ink_r;
+		px[1] = ink_g;
+		px[2] = ink_b;
+		px[3] = match coverage {
+			c if c <= PAPER_FLOOR => 0,
+			c if c >= INK_CEIL => u8::MAX,
+			c => (((c - PAPER_FLOOR) * 255) / (INK_CEIL - PAPER_FLOOR)) as u8
+		};
+	}
+}
