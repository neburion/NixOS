+/// Recolour a page the way zathura's `recolor-reverse-video` does, rather than
+/// by tinting every pixel between two endpoints.
+///
+/// Pixels carrying real chroma — photos, coloured figures, syntax highlighting
+/// — are left exactly as the document authored them. Grey pixels (the paper,
+/// the text, the rules) are judged by how dark they are: paper drops out to
+/// full transparency so the terminal's own background shows through the page,
+/// and everything darker is drawn as ink.
+///
+/// Ink is drawn **opaque**, blended against `paper` here rather than handed to
+/// the terminal as partial alpha. That is the difference between text that
+/// reads and text that doesn't. A glyph at this size is mostly antialiasing,
+/// and antialiasing expressed as alpha gets composited by the terminal in its
+/// own colour space — the result came out thin and grey. Blending it here, in
+/// sRGB, against the colour the terminal is about to draw anyway gives the
+/// same crisp edge zathura produces, and costs only a hairline of terminal
+/// background around each glyph instead of wallpaper.
+fn reverse_video(pixmap: &mut Pixmap, ink: i32, paper: i32) {
+	// How far apart the channels may be for a pixel to still count as grey.
+	// Generous enough to catch the off-whites and warm greys documents use for
+	// paper, tight enough to leave a washed-out photo alone.
+	const CHROMA_TOLERANCE: u8 = 24;
+	// Below this much ink coverage a pixel is paper, and drops out. Above it,
+	// coverage is stretched across the full ramp so that text which is a dark
+	// grey rather than true black still reaches full ink.
+	const PAPER_FLOOR: u32 = 10;
+	const INK_CEIL: u32 = 150;
+
+	let [_, ink_r, ink_g, ink_b] = ink.to_be_bytes();
+	let [_, paper_r, paper_g, paper_b] = paper.to_be_bytes();
+	let n = pixmap.n() as usize;
+	if n != 4 {
+		return;
+	}
+
+	let blend = |from: u8, to: u8, t: u32| -> u8 {
+		((u32::from(from) * (255 - t) + u32::from(to) * t) / 255) as u8
+	};
+
+	for px in pixmap.samples_mut().chunks_exact_mut(n) {
+		let alpha = px[3];
+		if alpha == 0 {
+			// never painted; the terminal is already showing through here
+			continue;
+		}
+
+		// undo mupdf's premultiplication before judging the colour
+		let un = |c: u8| ((u32::from(c) * 255) / u32::from(alpha)).min(255) as u8;
+		let (r, g, b) = (un(px[0]), un(px[1]), un(px[2]));
+
+		if r.max(g).max(b) - r.min(g).min(b) > CHROMA_TOLERANCE {
+			continue;
+		}
+
+		let coverage = u32::from(u8::MAX - ((u32::from(r) + u32::from(g) + u32::from(b)) / 3) as u8);
+		if coverage <= PAPER_FLOOR {
+			px[0] = 0;
+			px[1] = 0;
+			px[2] = 0;
+			px[3] = 0;
+			continue;
+		}
+
+		let t = (((coverage - PAPER_FLOOR) * 255) / (INK_CEIL - PAPER_FLOOR)).min(255);
+		px[0] = blend(paper_r, ink_r, t);
+		px[1] = blend(paper_g, ink_g, t);
+		px[2] = blend(paper_b, ink_b, t);
+		px[3] = u8::MAX;
+	}
+}
