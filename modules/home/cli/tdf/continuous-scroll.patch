+	/// Height of every page in cell rows, with a stand-in for the pages that
+	/// have not come back from the renderer yet.
+	///
+	/// The stand-in is the height of the first page that *has*: documents are
+	/// overwhelmingly uniform, and the guess only ever positions a page that
+	/// is about to be replaced by the real thing. Getting it a little wrong
+	/// costs a small jump in the scrollbar-less void, not a misdrawn page.
+	fn page_heights(&self, fallback: u16) -> (Vec<Option<u16>>, u16) {
+		let heights = self
+			.rendered
+			.iter()
+			.map(|r| r.img.as_ref().map(|img| img.w_h().1))
+			.collect::<Vec<_>>();
+		let typical = heights.iter().flatten().copied().next().unwrap_or(fallback);
+		(heights, typical)
+	}
+
+	/// Where a page starts, in cell rows from the top of the document.
+	fn page_offset(&self, page: usize) -> usize {
+		let (heights, typical) = self.page_heights(self.last_render.rect.height.max(1));
+		heights
+			.iter()
+			.take(page)
+			.map(|h| usize::from(h.unwrap_or(typical)) + usize::from(Self::PAGE_GAP))
+			.sum()
+	}
+
+	/// Draw the document as one strip.
+	///
+	/// Every page is rendered at the same width (the renderer is put in
+	/// fill-width mode for this), so the document is just those images stacked
+	/// with a row of gap between them. Scrolling is then a matter of which
+	/// slice of that strip the viewport covers: for each page that overlaps it
+	/// we send the Kitty protocol a source rectangle — the rows of that page
+	/// which are on screen — and a destination position. A page can therefore
+	/// be drawn half on screen, which is the whole point, and two pages can
+	/// share the viewport across their boundary.
+	///
+	/// This is the same display primitive the zoomed/panning path uses; only
+	/// the arithmetic deciding the rectangles is new.
+	fn render_continuous<'s>(
+		&'s mut self,
+		frame: &mut Frame<'_>,
+		img_area: Rect,
+		font_size: FontSize
+	) -> KittyDisplay<'s> {
+		let view_h = img_area.height;
+		if view_h == 0 || self.rendered.is_empty() {
+			return KittyDisplay::NoChange;
+		}
+
+		// Something outside this function moved the page; go there.
+		if self.page != self.anchor_page {
+			self.scroll = self.page_offset(self.page);
+		}
+
+		let (heights, typical) = self.page_heights(view_h);
+
+		let total = heights
+			.iter()
+			.map(|h| usize::from(h.unwrap_or(typical)) + usize::from(Self::PAGE_GAP))
+			.sum::<usize>();
+		self.scroll = self.scroll.min(total.saturating_sub(usize::from(view_h)));
+
+		let view_top = self.scroll;
+		let view_bottom = view_top + usize::from(view_h);
+
+		// (page, first row of the page to show, row of the viewport to put it
+		// on, how many rows of it are visible)
+		let mut plan: Vec<(usize, u16, u16, u16)> = Vec::new();
+		let mut first_visible = None;
+		let mut top = 0usize;
+
+		for (idx, height) in heights.iter().enumerate() {
+			let page_h = usize::from(height.unwrap_or(typical));
+			let bottom = top + page_h;
+
+			if bottom > view_top && top < view_bottom {
+				if first_visible.is_none() {
+					first_visible = Some(idx);
+				}
+
+				// Only pages that have actually been rendered can be drawn;
+				// the others hold their place in the strip and pop in when
+				// they arrive.
+				if height.is_some() {
+					let src_row = view_top.saturating_sub(top);
+					let dst_row = top.saturating_sub(view_top);
+					let rows = (page_h - src_row).min(view_bottom - (top + src_row));
+					if rows > 0 {
+						plan.push((
+							idx,
+							u16::try_from(src_row).unwrap_or(u16::MAX),
+							u16::try_from(dst_row).unwrap_or(u16::MAX),
+							u16::try_from(rows).unwrap_or(u16::MAX)
+						));
+					}
+				}
+			}
+
+			top = bottom + usize::from(Self::PAGE_GAP);
+			if top >= view_bottom {
+				break;
+			}
+		}
+
+		if let Some(first) = first_visible {
+			self.page = first;
+			self.anchor_page = first;
+		}
+
+		if plan.is_empty() {
+			Self::render_loading_in(frame, img_area);
+			return KittyDisplay::ClearImages;
+		}
+
+		execute!(stdout(), BeginSynchronizedUpdate).unwrap();
+
+		let (area_x, area_y, area_w) = (img_area.x, img_area.y, img_area.width);
+
+		let to_display = self
+			.rendered
+			.iter_mut()
+			.enumerate()
+			.filter_map(|(idx, page)| {
+				let (_, src_row, dst_row, rows) = *plan.iter().find(|(i, ..)| *i == idx)?;
+				let ConvertedImage::Kitty { img, cell_w, .. } = page.img.as_mut()? else {
+					return None;
+				};
+				let cell_w = *cell_w;
+
+				Some(KittyReadyToDisplay {
+					img,
+					page_num: idx,
+					pos: Position {
+						x: area_x + (area_w.saturating_sub(cell_w) / 2),
+						y: area_y + dst_row
+					},
+					display_loc: DisplayLocation {
+						x: 0,
+						y: u32::from(src_row) * u32::from(font_size.1),
+						width: u32::from(cell_w) * u32::from(font_size.0),
+						height: u32::from(rows) * u32::from(font_size.1),
+						columns: cell_w,
+						rows,
+						..DisplayLocation::default()
+					}
+				})
+			})
+			.collect::<Vec<_>>();
+
+		KittyDisplay::DisplayImages(to_display)
+	}
+
+	fn scroll_by(&mut self, delta: isize) -> Option<InputAction> {
+		self.scroll = self.scroll.saturating_add_signed(delta);
+		self.last_render.rect = Rect::default();
+		Some(InputAction::Redraw)
+	}
+
+	fn scroll_to_page(&mut self, page: usize) -> Option<InputAction> {
+		let page = page.min(self.rendered.len().saturating_sub(1));
+		self.scroll = self.page_offset(page);
+		self.page = page;
+		self.anchor_page = page;
+		self.last_render.rect = Rect::default();
+		Some(InputAction::JumpingToPage(page))
+	}
+
+	fn toggle_continuous(&mut self) -> Option<InputAction> {
+		self.continuous = !self.continuous;
+		self.zoom = None;
+		self.last_render.rect = Rect::default();
+		Some(InputAction::SwitchRenderZoom(if self.continuous {
+			FitOrFill::Fill
+		} else {
+			FitOrFill::Fit
+		}))
+	}
+
+	/// Keys that mean something different while the document is one strip.
+	/// Anything not handled here falls through to the normal bindings.
+	fn continuous_key(&mut self, key: &crossterm::event::KeyEvent) -> Option<InputAction> {
+		// ctrl+z still suspends, and every other modified key is left alone
+		if key.modifiers.contains(KeyModifiers::CONTROL) {
+			return None;
+		}
+
+		// A screenful, less a few rows, so there is overlap to read across.
+		let screen =
+			isize::try_from(self.last_render.rect.height.saturating_sub(8).max(1)).unwrap_or(1);
+
+		match key.code {
+			KeyCode::Char('j') | KeyCode::Down => self.scroll_by(Self::SCROLL_STEP),
+			KeyCode::Char('k') | KeyCode::Up => self.scroll_by(-Self::SCROLL_STEP),
+			KeyCode::Char('d') | KeyCode::Char(' ') | KeyCode::PageDown =>
+				self.scroll_by(screen),
+			KeyCode::Char('u') | KeyCode::PageUp => self.scroll_by(-screen),
+			KeyCode::Char('l') | KeyCode::Right => self.scroll_to_page(self.page + 1),
+			KeyCode::Char('h') | KeyCode::Left =>
+				self.scroll_to_page(self.page.saturating_sub(1)),
+			KeyCode::Char('c') => self.toggle_continuous(),
+			_ => None
+		}
+	}
