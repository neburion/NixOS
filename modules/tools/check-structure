#!/usr/bin/env bash
# check-structure — enforces DESIGN.md. Exit 1 on any violation.
#
# Each check names the law it enforces. Heuristic checks are marked; they may
# over-report on unusual-but-legal files, never under-report on the shapes
# DESIGN.md actually bans.

set -uo pipefail
cd "$(git -C "$(dirname "$0")" rev-parse --show-toplevel 2>/dev/null || echo .)" || exit 2

fail=0
say() { printf '\n\033[1m%s\033[0m  %s\n' "$1" "$2"; }
hit() { fail=$((fail+1)); printf '  %s\n' "$1"; }

# ---------------------------------------------------------------- L1 closed sets
allowed() { # $1 = dir, rest = allowed entries
  local dir="$1"; shift
  [ -d "$dir" ] || return 0
  local e
  for e in "$dir"/*; do
    [ -e "$e" ] || continue
    local n; n=$(basename "$e")
    case " $* " in *" $n "*) ;; *) hit "$dir/$n" ;; esac
  done
}

say "L1" "closed directory sets"
allowed modules                system home tools
allowed modules/system         core boot hardware network session services
allowed modules/home           cli apps toolchains desktop base.nix
allowed modules/tools          check-structure  # more land during the refactor
for h in hosts/*/; do
  allowed "${h%/}" configuration.nix hardware.nix hardware policy
done
for u in users/*/; do
  allowed "${u%/}" default.nix account.nix home.nix dirs.nix
done
SLOTS="default.nix palette.nix terminal.nix cursor.nix lock.nix shell wm bar launcher notifications osd wallpaper theming themes"
for p in modules/home/desktop/*/; do
  allowed "${p%/}" $SLOTS
done
[ -d iso ] && hit "iso/  (must be hosts/installer/)"
[ -d modules/home/themes ] && hit "modules/home/themes/  (a desktop owns its palettes — L8)"

# ------------------------------------------------------- L2 manifests are imports
say "L2" "manifests contain imports and nothing else  [heuristic]"
while IFS= read -r f; do
  grep -q 'imports' "$f" || continue
  # top-level attribute assignments other than imports
  body=$(awk '/^let$|^let /{inlet=1} inlet && /^in$|^in /{inlet=0; next} !inlet' "$f")
  extra=$(printf '%s\n' "$body" | grep -nE '^  [a-z][A-Za-z0-9_.]*[[:space:]]*=' \
          | grep -v ':  imports' || true)
  [ -n "$extra" ] && hit "$f: $(echo "$extra" | head -1 | sed 's/[[:space:]]*$//')"
done < <(find hosts users modules -name default.nix -o -name configuration.nix -o -path 'users/*/home.nix' 2>/dev/null)

# ------------------------------------------------------------------- L3 options
say "L3" "options carry host facts (resource claims excepted — see DESIGN.md)"
for f in $(grep -rl 'mkOption' modules --include='*.nix' 2>/dev/null); do
  for path in $(grep -oE '^[[:space:]]*options\.[A-Za-z][A-Za-z0-9_.]*' "$f" \
                | sed 's/.*options\.//; s/\.$//' | sort -u); do
    setters=$(grep -rlE "^[[:space:]]*(config\.)?${path}(\.[A-Za-z]|[[:space:]]*=)" modules \
              --include='*.nix' 2>/dev/null | grep -v "^$f$" || true)
    [ -n "$setters" ] || continue
    owner=$(echo "$f" | cut -d/ -f1-3)             # e.g. modules/system/network
    keyed=$(grep -qE 'attrsOf' "$f" && echo yes || echo no)
    bad=""
    while read -r st; do
      [ -n "$st" ] || continue
      # a resource claim is legal: attrsOf, and claimant outside the owner's directory,
      # and no preset on either side.
      case "$f$st" in *modules/home/desktop/*) bad="$bad $st"; continue ;; esac
      [ "$keyed" = yes ] && [ "${st#$owner/}" = "$st" ] && continue
      bad="$bad $st"
    done <<< "$setters"
    n=$(printf '%s' "$bad" | wc -w)
    [ "$n" -gt 0 ] && hit "$f declares '$path' — illegally set by $n module(s):$(echo $bad | cut -c1-90)$([ "$n" -gt 2 ] && echo ' …')"
  done
done

# --------------------------------------------------------------- L4 lines-typed
say "L4" "no registry is lines-typed"
for f in $(grep -rl 'mkOption' modules --include='*.nix' 2>/dev/null); do
  grep -qE 'types\.(lines|attrsOf[[:space:]]+.*types\.lines)' "$f" && hit "$f"
done

# ------------------------------------------------------------ L5 downward imports
say "L5" "imports go downward only"
grep -rn 'modules/system' users --include='*.nix' 2>/dev/null \
  | grep -vE ':[0-9]+:[[:space:]]*#' | while read -r l; do hit "$l"; done
grep -rn '\.\./\.\./hosts/' modules --include='*.nix' 2>/dev/null \
  | grep -vE ':[0-9]+:[[:space:]]*#' | while read -r l; do hit "$l"; done

# ------------------------------------------------------- L6 file-or-dir, not both
say "L6" "a name is a file or a directory, never both; no single-file dirs"
find modules hosts users -name '*.nix' 2>/dev/null | while read -r f; do
  d="${f%.nix}"; [ -d "$d" ] && hit "$f  and  $d/"
done
find modules hosts users -type d 2>/dev/null | while read -r d; do
  n=$(find "$d" -maxdepth 1 -type f | wc -l)
  s=$(find "$d" -maxdepth 1 -mindepth 1 -type d | wc -l)
  [ "$n" -eq 1 ] && [ "$s" -eq 0 ] && hit "$d/  (holds one file)"
done

# ------------------------------------------------ L7 fact / choice / generated
say "L7" "fact, choice and generated state are separate"
find hosts -name '*.lock.json' -o -name '*.lock' 2>/dev/null | while read -r f; do
  case "$f" in */hardware/*|*/policy/*|*hardware-layout*) hit "$f  (generated, inside a hand-edited dir)" ;; esac
done
[ -d hosts ] && find hosts -maxdepth 2 -name 'hardware-layout' 2>/dev/null | while read -r d; do
  hit "$d/  (split into hardware/ and policy/)"
done

# --------------------------------------------------------- L8 no palette outside
say "L8" "every palette lives inside a desktop"
grep -rln 'themeHooks\.' modules --include='*.nix' 2>/dev/null \
  | grep -v '^modules/home/desktop/' | while read -r f; do hit "$f  (registers a theme hook)"; done
grep -rlE '^\{[^}]*\bthemes\b' modules --include='*.nix' 2>/dev/null \
  | grep -v '^modules/home/desktop/' | while read -r f; do hit "$f  (takes the themes arg)"; done

printf '\n'
if [ "$fail" -eq 0 ]; then
  printf '\033[32mclean\033[0m — no structural violations\n'; exit 0
fi
printf '\033[31m%d violation(s)\033[0m — see DESIGN.md\n' "$fail"; exit 1
